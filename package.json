{
  "name": "rice-soft-backend",
  "version": "1.0.0",
  "description": "Rice Trading Management System Backend",
  "main": "dist/bin/init.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/bin/init.ts",
    "start": "node dist/bin/init.js",
    "watch": "tsc --watch",
    "dev:watch": "nodemon --exec ts-node src/bin/init.ts",
    "migrate": "ts-node src/database/migrations/run-migrations.ts",
    "create-admin": "ts-node src/scripts/create-admin.ts",
    "reset-admin-password": "ts-node src/scripts/reset-admin-password.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "rice",
    "trading",
    "management",
    "erp"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "open-location-code": "^1.0.3",
    "pg": "^8.11.3",
    "ua-parser-js": "^2.0.6",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.19.21",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
